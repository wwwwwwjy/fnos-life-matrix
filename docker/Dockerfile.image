FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1
COPY --chmod=644 panel/server.py sampler.py
COPY --chmod=644 docker/bridge.py bridge.py
COPY --chmod=644 LICENSE /usr/share/licenses/fnos-life-matrix/LICENSE
LABEL org.opencontainers.image.title="fnOS Life Matrix" \
      org.opencontainers.image.description="USB serial bridge from fnOS to an ESP32 MAX7219 Game of Life panel" \
      org.opencontainers.image.source="https://github.com/wwwwwwjy/fnos-life-matrix" \
      org.opencontainers.image.licenses="MIT"
EXPOSE 8765/tcp
USER 65534:65534
RUN python -c "import bridge"
CMD ["python", "-u", "bridge.py"]
